{
  "description": "Two delegations narrow the per-act ceiling. The final holder proposes within it.",
  "bindings": [
    ["scope", {"domain": "market", "operation": "refund", "target": "order/39", "purpose": "return", "executor": "cashier"}],
    ["root", {"id": 0, "holder": "store", "scope": {"$ref": "scope"}, "ceiling": 100, "ancestors": []}],
    ["child", {"id": 1, "holder": "assistant", "scope": {"$ref": "scope"}, "ceiling": 60, "ancestors": [0]}],
    ["grand", {"id": 2, "holder": "counter", "scope": {"$ref": "scope"}, "ceiling": 25, "ancestors": [1, 0]}],
    ["small", {"id": 2, "proposer": "counter", "mandate": {"$ref": "grand"}, "scope": {"$ref": "scope"}, "cost": 25}]
